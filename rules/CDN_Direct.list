# NAME: CDN_Direct_List
# AUTHOR: LceAn
# REPO: https://github.com/LceAn/proxy-filter-rules
# UPDATED: 2026-06-02
# DESCRIPTION: 图片/媒体 CDN 直连规则（Quantumult X 格式）
# USAGE: 放在 WeChat/TencentQQ/DingTalk 规则之上，确保 CDN 域名直连
# PROBLEM: 微信/钉钉发图慢 → 因为图片 CDN 被分流到代理节点绕路
# FIX: 图片/媒体 CDN 走 DIRECT，不走代理
#
# HOST: 6
# HOST-SUFFIX: 19
# IP-CIDR: 8
# TOTAL: 33

# ==================== 微信图片/表情/媒体 CDN ====================

# 微信图片存储（最核心）
HOST-SUFFIX,qpic.cn,CDN_Direct
HOST-SUFFIX,wx.gtimg.com,CDN_Direct
HOST-SUFFIX,vweixinthumb.tc.qq.com,CDN_Direct

# 微信头像
HOST-SUFFIX,qlogo.cn,CDN_Direct
HOST-SUFFIX,qlogo.com,CDN_Direct
HOST-SUFFIX,qlogo.cc,CDN_Direct

# 微信公众号/小程序图片
HOST-SUFFIX,bbcdn.cn,CDN_Direct
HOST-SUFFIX,mmbiz.qpic.cn,CDN_Direct

# ==================== 腾讯通用 CDN ====================

# 腾讯图片 CDN（QQ 头像、表情、图片）
HOST-SUFFIX,gtimg.cn,CDN_Direct
HOST-SUFFIX,gtimg.com,CDN_Direct
HOST-SUFFIX,gtimg.com.cn,CDN_Direct

# 腾讯云 COS（文件上传/对象存储）
HOST-SUFFIX,myqcloud.cn,CDN_Direct
HOST-SUFFIX,myqcloud.com,CDN_Direct
HOST-SUFFIX,myqcloud.net,CDN_Direct
HOST-SUFFIX,tencentcos.cloud,CDN_Direct

# 腾讯 CDN 节点
HOST-SUFFIX,cdntip.com,CDN_Direct
HOST-SUFFIX,cdntips.com,CDN_Direct
HOST-SUFFIX,cdntips.net,CDN_Direct

# ==================== 钉钉/阿里 CDN ====================

# 阿里云 CDN（钉钉图片、文件走这里）
HOST-SUFFIX,alicdn.com,CDN_Direct
HOST-SUFFIX,alicdn.net,CDN_Direct
HOST-SUFFIX,img.alicdn.com,CDN_Direct
HOST-SUFFIX,g.alicdn.com,CDN_Direct
HOST-SUFFIX,assets.alicdn.com,CDN_Direct

# ==================== IP 直连（腾讯/阿里 CDN 段） ====================

# 腾讯 CDN IP 段
IP-CIDR,58.60.0.0/16,no-resolve
IP-CIDR,106.11.0.0/16,no-resolve
IP-CIDR,183.60.0.0/16,no-resolve
IP-CIDR,203.205.128.0/17,no-resolve
IP-CIDR,182.254.0.0/16,no-resolve

# 阿里 CDN IP 段（淘宝/钉钉共用）
IP-CIDR,140.205.0.0/16,no-resolve
IP-CIDR,163.181.0.0/16,no-resolve
